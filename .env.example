# ── Welliva API — server-side secrets (NEVER ship these in the mobile app) ──

# Anthropic API key. The whole point of this backend is to keep this key OFF
# the device — it lives here only.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model is HARD-LOCKED to Claude Haiku in code. You may pin the exact Haiku
# snapshot here, but any non-Haiku id is ignored and forced back to Haiku.
CLAUDE_MODEL=claude-haiku-4-5

# USDA FoodData Central — the MEASURED source behind /v1/nutrition/lookup.
# Free key, issued instantly: https://fdc.nal.usda.gov/api-key-signup.html
#
# Server-side only. It must never reach the client — keeping it here is the
# reason food lookup runs on the server rather than in the app.
#
# Without it the endpoint still answers, but it has no measured source to try
# first and every result comes back as an AI estimate. Set it.
FDC_API_KEY=

# ── Auth (required) ──
# Every /v1 endpoint requires a signed-in Supabase user. These verify the
# access token the app sends; without them the server refuses to boot.

# Your Supabase project URL — same value as the app's EXPO_PUBLIC_SUPABASE_URL.
# Used as the expected token issuer, so a token from another project is rejected.
SUPABASE_URL=https://your-project.supabase.co

# ONLY for legacy HS256 projects: Project Settings → API → JWT Secret.
# This is a SECRET — it verifies tokens, never put it in the app.
# Newer projects sign asymmetrically; leave this blank and the project's public
# JWKS endpoint is used automatically.
SUPABASE_JWT_SECRET=

# ── Per-user rate limits (cost guard on the AI endpoints) ──
# Burst window, and a rolling-day ceiling. Counted per Supabase user id.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DAILY_MAX=300

# HTTP port the API listens on.
PORT=8787

# Comma-separated allowed CORS origins, or "*" for any (dev only).
# Only relevant if you serve Welliva on the web — the native app sends no
# Origin header, so the JWT check is what actually protects these endpoints.
CORS_ORIGIN=*

NODE_ENV=development
