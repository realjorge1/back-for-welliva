{
  "name": "welliva-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Welliva backend API — Gozlin AI coach + AI-generated diet/workout programs. Locked to Claude Haiku.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:auth": "tsx src/authCheck.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^6.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
